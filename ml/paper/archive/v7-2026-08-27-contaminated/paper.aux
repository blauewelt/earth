\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The AMOC read-out of the \emph  {champion} heads --- the E-043b no-longitude-holdout pair, the best rolled configuration on record (corridor AUC $0.93733$/$0.93758$, both seeds shown) --- against the frozen no-neighbour gate. (The frontier pentad head of \S  \ref {sec:factorial}, one-step $0.0330$, has no roll yet; this figure shows the best heads that \emph  {have} been rolled.) Left: hindcast from a 2004 context, with the three never-trained years shaded. \textbf  {Those columns are not a test, and the legend's $r$ is not a skill number}: \S  \ref {sec:replay} rolls this configuration from six context ends spanning a decade and finds the tracking correlation \emph  {flat} in lead time and the post-record peaks pinned to fixed calendar months whatever the starting state. The whole left panel --- shaded columns included --- is trajectory replay, and its $r$ is relabelled here as replay tracking: it measures how completely the head has memorized the record, not how well it forecasts. Right: twenty years of unforced roll past the end of the record. The flatness on the right is the finding, not a forecast: with no wind or heat-flux forcing after the seam, the learned dynamics relaxes toward climatology and stops moving, which is a damped attractor rather than a quiet ocean --- and \S  \ref {sec:replay} adds that what residual motion there is repeats on an integer number of years. Interactive version, with the per-arm table, at \texttt  {blauewelt.github.io/earth/ml/paper/figs/amoc\_roll.html}.}}{26}{figure.10}\protected@file@percent }
\newlabel{fig:amocroll}{{10}{26}{The AMOC read-out of the \emph {champion} heads --- the E-043b no-longitude-holdout pair, the best rolled configuration on record (corridor AUC $0.93733$/$0.93758$, both seeds shown) --- against the frozen no-neighbour gate. (The frontier pentad head of \S \ref {sec:factorial}, one-step $0.0330$, has no roll yet; this figure shows the best heads that \emph {have} been rolled.) Left: hindcast from a 2004 context, with the three never-trained years shaded. \textbf {Those columns are not a test, and the legend's $r$ is not a skill number}: \S \ref {sec:replay} rolls this configuration from six context ends spanning a decade and finds the tracking correlation \emph {flat} in lead time and the post-record peaks pinned to fixed calendar months whatever the starting state. The whole left panel --- shaded columns included --- is trajectory replay, and its $r$ is relabelled here as replay tracking: it measures how completely the head has memorized the record, not how well it forecasts. Right: twenty years of unforced roll past the end of the record. The flatness on the right is the finding, not a forecast: with no wind or heat-flux forcing after the seam, the learned dynamics relaxes toward climatology and stops moving, which is a damped attractor rather than a quiet ocean --- and \S \ref {sec:replay} adds that what residual motion there is repeats on an integer number of years. Interactive version, with the per-arm table, at \texttt {blauewelt.github.io/earth/ml/paper/figs/amoc\_roll.html}}{figure.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {The $2\times 2$, rolled corridor AUC.} Both rows at $1024\times 16$, 200k steps, same schedule; every cell is now the mean of two seeds. The noise column is $+0.045$ to $+0.050$; the width row is $-0.004$ and $+0.0005$. The interaction term --- whether noise pays \emph  {more} at greater width --- is $+0.0047$, at the scale of the seed spread it would have to clear.}}{26}{table.6}\protected@file@percent }
\newlabel{tab:twobytwo}{{6}{26}{\textbf {The $2\times 2$, rolled corridor AUC.} Both rows at $1024\times 16$, 200k steps, same schedule; every cell is now the mean of two seeds. The noise column is $+0.045$ to $+0.050$; the width row is $-0.004$ and $+0.0005$. The interaction term --- whether noise pays \emph {more} at greater width --- is $+0.0047$, at the scale of the seed spread it would have to clear}{table.6}{}}

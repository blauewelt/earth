\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {The step $\times $ span factorial.} Every measured arm of E-044b/E-045, plotted twice: against context span (left) and against step size (right). Same points, same colors (step size). Span collapses the ratios onto one monotone family; step size scatters them. The decisive rung (E-045.1: 5-day steps at the full 720-day span) landed at $0.082$, inside its pre-registered $0.07$--$0.15$ band.}}{35}{figure.12}\protected@file@percent }
\newlabel{fig:factorial}{{12}{35}{\textbf {The step $\times $ span factorial.} Every measured arm of E-044b/E-045, plotted twice: against context span (left) and against step size (right). Same points, same colors (step size). Span collapses the ratios onto one monotone family; step size scatters them. The decisive rung (E-045.1: 5-day steps at the full 720-day span) landed at $0.082$, inside its pre-registered $0.07$--$0.15$ band}{figure.12}{}}

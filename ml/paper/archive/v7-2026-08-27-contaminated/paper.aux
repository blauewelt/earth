\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The sharpest event in the RAPID record, predicted out-of-fold. Without wind channels (blue) the model captures 16\% of the dip amplitude; with them (orange), 50\%. The 25-channel codec reaches 59\% (not plotted; see Table~\ref {tab:master}). The November onset --- triggered inside a month --- stays invisible to monthly data.}}{19}{figure.6}\protected@file@percent }
\newlabel{fig:dip}{{6}{19}{The sharpest event in the RAPID record, predicted out-of-fold. Without wind channels (blue) the model captures 16\% of the dip amplitude; with them (orange), 50\%. The 25-channel codec reaches 59\% (not plotted; see Table~\ref {tab:master}). The November onset --- triggered inside a month --- stays invisible to monthly data}{figure.6}{}}

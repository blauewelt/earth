\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Where the noise gain lives.} Corridor MSSS against climatology by horizon, for the 233-point 205M arms with and without $\sigma {=}0.7$ input noise. Both columns are two-seed means. The noised model is \emph  {worse} at one step and better at every horizon after, with the advantage growing at every horizon shown and reaching $+0.074$ at a year (its maximum over all twelve is $+0.077$, at eleven months). This is the exposure-bias signature stated as a prediction in \S  \ref {sec:exposure}, measured: noise buys stability under iteration and pays for it in one-step accuracy.}}{27}{table.7}\protected@file@percent }
\newlabel{tab:noisehorizon}{{7}{27}{\textbf {Where the noise gain lives.} Corridor MSSS against climatology by horizon, for the 233-point 205M arms with and without $\sigma {=}0.7$ input noise. Both columns are two-seed means. The noised model is \emph {worse} at one step and better at every horizon after, with the advantage growing at every horizon shown and reaching $+0.074$ at a year (its maximum over all twelve is $+0.077$, at eleven months). This is the exposure-bias signature stated as a prediction in \S \ref {sec:exposure}, measured: noise buys stability under iteration and pays for it in one-step accuracy}{table.7}{}}

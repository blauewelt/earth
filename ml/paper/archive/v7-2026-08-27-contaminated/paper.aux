\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Sixteen Argo temperature and salinity levels to 1900\,dbar \emph  {appeared} to cost monthly RAPID skill under pooled probes (left, first pair) --- resolved by \S  \ref {sec:ladder} as a read-out artifact, not a representation change --- while genuinely roughly doubling skill at MOVE (left, second pair) and transforming the low-frequency read-out there (right). MOVE measures the \emph  {deep} western-boundary flow at $16^\circ $N --- precisely the quantity the added levels describe.}}{18}{figure.4}\protected@file@percent }
\newlabel{fig:tradeoff}{{4}{18}{Sixteen Argo temperature and salinity levels to 1900\,dbar \emph {appeared} to cost monthly RAPID skill under pooled probes (left, first pair) --- resolved by \S \ref {sec:ladder} as a read-out artifact, not a representation change --- while genuinely roughly doubling skill at MOVE (left, second pair) and transforming the low-frequency read-out there (right). MOVE measures the \emph {deep} western-boundary flow at $16^\circ $N --- precisely the quantity the added levels describe}{figure.4}{}}

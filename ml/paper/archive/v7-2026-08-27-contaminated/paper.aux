\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Rolled corridor AUC, per seed} --- the reference table for the metric defined in \S  \ref {sec:gloss}. Every row is read from an evaluation whose gate head reproduced its pinned $0.643$ exactly; the full per-horizon and per-channel outputs are archived per evaluation run (\texttt  {ml-metrics} branch). The upper block is the capacity ladder at fixed input. \textbf  {The middle block is the result that reorders this section}: neither row is a capacity change, and both beat the tier they belong to --- input noise by $+0.057$ and near-field geometry by $+0.035$ over the same 88M model, with the \emph  {noised 88M} model beating the \emph  {clean 205M} one outright. \textbf  {The bottom block is what happens when the two are composed}, and it holds the best numbers in the programme by a margin larger than the gap between the top of the capacity ladder and its second rung: $0.7235$/$0.7240$ against $0.6785$ for noise alone and $0.6781$ for width alone. The two noised rows sit $0.0005$ apart across a $1.6\times $ change in input width --- which is the finding of \S  \ref {sec:interaction}, in one line. The clean xl233 row is now a completed pair: its seed-0 partner, lost at first to a truncated checkpoint upload, was retrained and rolled, and the two seeds read $0.67492$/$0.67292$ --- a spread of $0.0020$, the tightest of the five pairs at this tier, and a mean $0.0042$ below xl144. The base-scale geometry table behind the ring-8@222 row is Appendix~\ref {app:base}.}}{24}{table.5}\protected@file@percent }
\newlabel{tab:auc}{{5}{24}{\textbf {Rolled corridor AUC, per seed} --- the reference table for the metric defined in \S \ref {sec:gloss}. Every row is read from an evaluation whose gate head reproduced its pinned $0.643$ exactly; the full per-horizon and per-channel outputs are archived per evaluation run (\texttt {ml-metrics} branch). The upper block is the capacity ladder at fixed input. \textbf {The middle block is the result that reorders this section}: neither row is a capacity change, and both beat the tier they belong to --- input noise by $+0.057$ and near-field geometry by $+0.035$ over the same 88M model, with the \emph {noised 88M} model beating the \emph {clean 205M} one outright. \textbf {The bottom block is what happens when the two are composed}, and it holds the best numbers in the programme by a margin larger than the gap between the top of the capacity ladder and its second rung: $0.7235$/$0.7240$ against $0.6785$ for noise alone and $0.6781$ for width alone. The two noised rows sit $0.0005$ apart across a $1.6\times $ change in input width --- which is the finding of \S \ref {sec:interaction}, in one line. The clean xl233 row is now a completed pair: its seed-0 partner, lost at first to a truncated checkpoint upload, was retrained and rolled, and the two seeds read $0.67492$/$0.67292$ --- a spread of $0.0020$, the tightest of the five pairs at this tier, and a mean $0.0042$ below xl144. The base-scale geometry table behind the ring-8@222 row is Appendix~\ref {app:base}}{table.5}{}}
